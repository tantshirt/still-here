{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/data/data-manifest.json", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "geolocation=(), camera=(), microphone=()",
        "X-Content-Type-Options": "nosniff",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    { "src": "/data/(.*)\\.[a-f0-9]{16}\\.json", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    {
      "src": "/assets/(.*)-([A-Za-z0-9_-]{8,})\\.(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/fonts/(.*).woff2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
